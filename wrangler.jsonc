{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fxpulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fxpulse-db",
      "database_id": "9ab59337-682e-4c0a-8b15-cbd0132b475a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
